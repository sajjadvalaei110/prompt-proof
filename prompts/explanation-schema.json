{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "shortLabel": {
      "type": "string"
    },
    "hoverSummary": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "basis": { "type": "string", "enum": ["SOURCE_FACT", "INFERRED_PURPOSE", "UNKNOWN"] },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["description", "basis", "evidenceIds"]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestedNextSymbolIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["shortLabel", "hoverSummary", "claims", "unknowns", "suggestedNextSymbolIds"]
}
